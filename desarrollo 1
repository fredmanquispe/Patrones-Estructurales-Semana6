class PagoDolares:
    """Clase existente (Adaptee) que realiza pagos en dólares."""
    def pagar_en_dolares(self, monto):
        return f"Pago de ${monto:.2f} realizado con éxito"

class AdaptadorPago:
    """El Adaptador que convierte la operación a Soles (PEN)."""
    def __init__(self, pago_dolares, tasa_cambio=3.75):
        self.pago_dolares = pago_dolares
        self.tasa_cambio = tasa_cambio  # 1 USD = 3.75 PEN (ejemplo)

    def pagar_en_soles(self, monto_soles):
        # Convertimos los soles a dólares antes de enviarlo al sistema original
        monto_dolares = monto_soles / self.tasa_cambio
        
        # Llamamos al método del objeto adaptado
        resultado_original = self.pago_dolares.pagar_en_dolares(monto_dolares)
        
        return f"Adaptado a Soles -> {resultado_original} (Equivalente a S/. {monto_soles:.2f})"

